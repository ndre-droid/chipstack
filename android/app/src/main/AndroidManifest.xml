<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- A foldable changes size, aspect AND density in the middle of a game.
             Every one of those is listed here, so unfolding resizes the running
             webview instead of restarting the activity underneath it: the clock
             keeps ticking, the live session stays paired, and nothing flashes.
             `fontScale` is deliberately NOT listed - the webview reads the text
             zoom when it is created, so that one still wants a restart. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density|navigation"
            android:resizeableActivity="true"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: chipstack://tv/NNNN opens the app straight into a session.
                 The TV's QR encodes the https page; on Android it hands off here. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="chipstack" />
            </intent-filter>

            <!-- Verified https App Link: opening the deployed page can open the app
                 directly. Needs .well-known/assetlinks.json on the domain to auto-verify;
                 until then Android may show an app chooser (the custom scheme above is
                 the reliable path). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="ndre-droid.github.io" android:pathPrefix="/chipstack" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Haptics. navigator.vibrate() is a silent no-op in the WebView without this,
         which is why the ruler's per-chip buzz never fired in the APK. -->
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
