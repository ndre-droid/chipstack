<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!--
        The theme the activity actually runs under.

        The system bars are set here because they were not set anywhere: this theme
        descends from a LIGHT one, so Android painted the navigation bar white and
        left a bright strip under a dark app, the full width of the screen. It is
        most obvious on a big screen — the Fold unfolded is where it was reported —
        and it is not something the web layer can reach, because the bars are the
        window's, not the page's.

        The two colours are API 21 attributes and minSdkVersion is 22, so they live
        here. Telling the system to draw the ICONS in those bars light is API 23 and
        27, which is newer than this app's floor — those two go in values-v27 so a
        build against an older device configuration never sees them.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@color/chipstackShell</item>
        <item name="android:navigationBarColor">@color/chipstackShell</item>
    </style>
</resources>