<?xml version="1.0" encoding="utf-8"?>
<!--
    The status-bar icon for the level-end notification.

    Android does not draw this icon, it draws its SILHOUETTE: every non-transparent
    pixel is filled with the system's notification tint, whatever colour it was. The
    launcher icon is a detailed tile with gradients and a drop shadow, so leaving
    this unset (the plugin's default) posts a solid white square in the status bar.

    So the mark is restated as three bare pills, which is what the app icon reduces
    to once colour is taken away — same proportions as scripts/gen-icons.mjs (bar
    height 0.2459 of the stack box, gap 0.0738), centred in the 24dp canvas with the
    2dp of padding the platform expects.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3.9,5.16 H20.1 A1.9,1.9 0 0 1 20.1,8.96 H3.9 A1.9,1.9 0 0 1 3.9,5.16 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3.9,10.1 H20.1 A1.9,1.9 0 0 1 20.1,13.9 H3.9 A1.9,1.9 0 0 1 3.9,10.1 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3.9,15.04 H20.1 A1.9,1.9 0 0 1 20.1,18.84 H3.9 A1.9,1.9 0 0 1 3.9,15.04 Z" />
</vector>
