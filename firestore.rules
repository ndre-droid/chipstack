rules_version = '2';

/*
 * ChipStack live sessions (project `chipstack-live`).
 *
 * The model: a TV publishes a four-digit code, a phone types it, and both sides
 * read and write one document. There are still no accounts — you pair by typing
 * four digits, not by logging in — but every client now signs in ANONYMOUSLY in the
 * background (see `lib/firebase.ts`), which gives these rules something real to
 * check. Four digits is 9000 guesses; that is minutes of work, and under the
 * previous rules a guess could read, overwrite or DELETE somebody's live table.
 *
 * What is enforced here:
 *   - nothing is readable or writable without a signed-in device
 *   - only four-digit document ids exist at all
 *   - a session records the uid of the screen that created it (`tvUid`) and of the
 *     phone that claimed it (`hostUid`); once claimed, only those two may write.
 *     An unclaimed session stays open — that IS the pairing act.
 *   - deletes are for the owning screen only
 *   - only the fields the app writes are accepted, with the types it expects
 *   - `expiresAt` is REQUIRED on every write, so the TTL policy on that field can
 *     sweep abandoned sessions (the policy is a console/gcloud setting, not part of
 *     this file)
 *   - the game document is bounded structurally (a map has no byte-size function in
 *     rules, so the caps are on list lengths) and the background photo is capped
 *     outright, in its own document, so the game data stays small
 *
 * ============================ DEPLOY ORDER — READ ============================
 * These rules REJECT clients that do not sign in and do not send `expiresAt`.
 * Deploying them out of order takes live sync down. Do it in this order:
 *   1. Firebase console -> Authentication -> Sign-in method -> enable ANONYMOUS.
 *      (Without this, `signInAnonymously` fails and every client is rejected.)
 *   2. Ship the app: push to `main` (GitHub Pages redeploys itself) AND rebuild the
 *      Android APK, then install it. An older APK still on a phone will lose live
 *      sync until it is updated.
 *   3. `firebase deploy --only firestore:rules`
 * Note for debugging: reading a session over the plain REST API with the public web
 * key no longer works — that read is unauthenticated.
 * =============================================================================
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // Session documents are the four-digit pairing code; the background photo lives
    // beside its session as `NNNN-bg` (a sibling, not a subcollection — see
    // lib/liveSession.ts for why).
    function isCode(id) {
      return id.matches('^[0-9]{4}$');
    }
    function isBackground(id) {
      return id.matches('^[0-9]{4}-bg$');
    }
    /* Guests write here: people asking to be seated, and the hand-of-the-night vote.
       Kept in their own documents so a guest never touches the session document —
       the game payload stays the host's alone. */
    function isJoins(id) {
      return id.matches('^[0-9]{4}-joins$');
    }
    function isVotes(id) {
      return id.matches('^[0-9]{4}-votes$');
    }
    /* A guest document is only writable while the session it belongs to exists, so
       the code has to have been shown on a real screen. That is the same level of
       trust as the code itself, which is the point: everyone in the room can see it,
       and nobody outside can do anything with it beyond adding a name to a list the
       host has to accept. */
    function sessionAlive(id) {
      return exists(/databases/$(database)/documents/sessions/$(id.split('-')[0]));
    }
    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return request.auth.uid;
    }
    function incoming() {
      return request.resource.data;
    }

    /* Every write pushes the sweep date out again, and never further than a couple
       of days: that is what stops an abandoned session living forever. Required, not
       tolerated — a client that cannot be swept has no business writing here. */
    function ttlOk() {
      return incoming().expiresAt is timestamp
        && incoming().expiresAt.toMillis() > request.time.toMillis()
        && incoming().expiresAt.toMillis() < request.time.toMillis() + 172800000;
    }

    /* Bounds on the game payload. Rules cannot measure a map in bytes, so the caps
       sit on the lists that can actually grow — a runaway ledger or a pasted wall of
       custom quips would otherwise walk the document up to the 1 MiB limit and make
       every later push fail mid-game. Generous: a home game is under ten players. */
    function listOk(m, key, max) {
      return !(key in m) || m[key] == null || m[key].size() <= max;
    }
    function dataOk() {
      return !('data' in incoming())
        || incoming().data == null
        || (incoming().data is map
            && incoming().data.keys().size() <= 48
            && listOk(incoming().data, 'ledger', 60)
            && listOk(incoming().data, 'denominations', 40)
            && listOk(incoming().data, 'moments', 120)
            && listOk(incoming().data, 'tvCustomQuips', 120)
            && listOk(incoming().data, 'tvPenalties', 120)
            && listOk(incoming().data, 'tvHouseRules', 120));
    }

    function fieldsOk() {
      return incoming().keys().hasOnly(
        ['data', 'clock', 'tvSeenAt', 'hostSeenAt', 'tvUid', 'hostUid', 'updatedAt', 'expiresAt'])
        && dataOk()
        && (!('clock' in incoming()) || incoming().clock is map)
        && (!('tvUid' in incoming()) || incoming().tvUid is string)
        && (!('hostUid' in incoming()) || incoming().hostUid is string);
    }

    /* The photo document `NNNN-bg` has no owner fields of its own — it is written by
       the phone and deleted by the screen — so it borrows the session's. One extra
       document read per photo write, which happens once a night at most. */
    function sessionOf(id) {
      return get(/databases/$(database)/documents/sessions/$(id.split('-')[0]));
    }
    function ownsBackground(id) {
      return exists(/databases/$(database)/documents/sessions/$(id.split('-')[0]))
        && (!('tvUid' in sessionOf(id).data)
            || sessionOf(id).data.tvUid == me()
            || !('hostUid' in sessionOf(id).data)
            || sessionOf(id).data.hostUid == me());
    }

    /* Who may change an existing session. The screen that made it and the phone that
       claimed it — plus anybody while it is still unclaimed, because typing the code
       on a phone IS the claim. Documents written by an older build carry no uid at
       all; they stay writable so a session in progress does not die on deploy. */
    function ownsSession() {
      return !('tvUid' in resource.data)
        || resource.data.tvUid == me()
        || !('hostUid' in resource.data)
        || resource.data.hostUid == me();
    }

    match /sessions/{id} {
      // The code alone is no longer enough to watch a table from the outside.
      allow read: if signedIn() && (isCode(id) || isBackground(id) || isJoins(id) || isVotes(id));

      allow create: if signedIn() && isCode(id) && ttlOk() && fieldsOk()
        // whoever creates a session must claim it in the same write
        && (!('tvUid' in incoming()) || incoming().tvUid == me())
        && (!('hostUid' in incoming()) || incoming().hostUid == me());

      allow update: if signedIn() && isCode(id) && ttlOk() && fieldsOk() && ownsSession()
        // you may only ever write your OWN uid into an ownership field
        && (!('tvUid' in incoming()) || incoming().tvUid == me() || incoming().tvUid == resource.data.tvUid)
        && (!('hostUid' in incoming()) || incoming().hostUid == me() || incoming().hostUid == resource.data.hostUid);

      /* The background photo. Capped well under the 1 MiB document limit and about
         twice what the app's encoder aims for, so an oversized photo is refused
         outright instead of failing as an oversized document mid-session. */
      allow create, update: if signedIn() && isBackground(id)
        && ownsBackground(id)
        && ttlOk()
        && incoming().keys().hasOnly(['image', 'updatedAt', 'expiresAt'])
        && (incoming().image == null
            || (incoming().image is string && incoming().image.size() < 400000));

      /* Join requests and votes: any signed-in device that has the code may write,
         because that is exactly what a guest is. Bounded hard — a list of names, and
         a map of votes — so the worst a stranger who guessed the code can do is add
         a name the host declines. */
      allow create, update: if signedIn() && isJoins(id) && sessionAlive(id) && ttlOk()
        && incoming().keys().hasOnly(['requests', 'updatedAt', 'expiresAt'])
        && incoming().requests is list
        && incoming().requests.size() <= 16;

      allow create, update: if signedIn() && isVotes(id) && sessionAlive(id) && ttlOk()
        && incoming().keys().hasOnly(['votes', 'updatedAt', 'expiresAt'])
        && incoming().votes is map
        && incoming().votes.keys().size() <= 30;

      /* The TV deletes its session (and its photo) when the big screen is switched
         off. Restricted to the owning screen: a guessed code used to be enough to
         wipe a table mid-game. The TTL policy is the backstop either way. */
      allow delete: if signedIn()
        && ((isCode(id) && (!('tvUid' in resource.data) || resource.data.tvUid == me()))
            || (isBackground(id) && ownsBackground(id))
            // the guest documents go with the session; only its owner clears them
            || ((isJoins(id) || isVotes(id)) && ownsBackground(id)));
    }

    // Nothing else in this project is public.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
